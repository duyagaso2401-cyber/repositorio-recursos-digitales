# -----------------------------------------------------------------------
# Variables de entorno requeridas
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo .env a un repositorio público.
# -----------------------------------------------------------------------

# Cadena de conexión a MongoDB Atlas (obligatoria)
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?appName=<nombre>
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.mongodb.net/?appName=MIAPP

# Puerto del servidor (opcional, por defecto 5000)
PORT=5000

# Entorno de ejecución
NODE_ENV=production
