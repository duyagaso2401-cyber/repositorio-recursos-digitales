# -----------------------------------------------------------------------
# Variables de entorno
# Copia este archivo como ".env" (solo para uso local) y rellena los valores.
# En Render se configuran en: Service > Environment.
# NUNCA subas el archivo .env a GitHub.
# -----------------------------------------------------------------------

# Cadena de conexión a MongoDB Atlas (OBLIGATORIA)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.mongodb.net/?appName=MIAPP

# Texto largo y aleatorio para firmar las sesiones (RECOMENDADA)
# Si no se define, todos los usuarios deben ingresar de nuevo cada vez que el servidor se reinicia.
AUTH_SECRET=escribe-aqui-un-texto-largo-y-aleatorio

# Datos de demostración (usuarios docente1/estudiante1/padre1 y 2 recursos de ejemplo)
# Se crean solo la primera vez. Pon false para no crearlos.
SEED_DEMO=true

PORT=5000
NODE_ENV=production
